import { ChromePalette } from "../theme/chrome-palette.slint";

// Shown in the toolbar when the active tab's page tried to open a pop-up without a click or
// key press. It is part of the browser's chrome, never of the page area, and names the origin.
// Colours come from the chrome palette's information-bar roles.
export component PopUpBlockedIndicator inherits Rectangle {
    in property <string> origin;
    callback allow;
    callback dismiss;

    height: 34px;
    max-width: 420px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ChromePalette.info-border;
    background: ChromePalette.info-background;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 8px;

        Text {
            text: "Pop-up blocked";
            color: ChromePalette.info-text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }

        allow-button := Rectangle {
            horizontal-stretch: 1;
            min-width: 80px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: allow-touch.pressed
                ? ChromePalette.button-pressed
                : allow-touch.has-hover ? ChromePalette.button-hover : transparent;

            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: "Allow pop-ups from " + root.origin;
                color: ChromePalette.accent;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }

            allow-touch := TouchArea {
                clicked => {
                    root.allow();
                }
            }
        }

        Rectangle {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: dismiss-touch.has-hover ? ChromePalette.button-hover : transparent;

            Text {
                text: "×";
                color: ChromePalette.button-label;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            dismiss-touch := TouchArea {
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}
