// Rule: every window gets its own copy of this global, so each window's Rust side must call
// `settings::apply_chrome_theme(&window)` once after creating it; colours come only from here.
import { Palette } from "std-widgets.slint";

// The appearance setting, as the browser's own chrome applies it.
export enum ChromeTheme {
    system,
    light,
    dark,
}

// The browser chrome's colours, by role. Every part of the browser's own UI takes its colours
// from here, so that it follows the appearance setting. The dark values are the chrome's
// original ones; with `system` the chrome follows the window's colour scheme, and stays dark
// when that is unknown.
export global ChromePalette {
    in property <ChromeTheme> theme: ChromeTheme.system;
    out property <bool> dark: root.theme == ChromeTheme.system
        ? Palette.color-scheme != ColorScheme.light
        : root.theme == ChromeTheme.dark;

    out property <color> window-background: root.dark ? #0b0f14 : #e9edf2;
    out property <color> toolbar-background: root.dark ? #11171f : #f7f8fa;
    out property <color> toolbar-divider: root.dark ? #202832 : #d6dce3;
    out property <color> content-background: root.dark ? #0c1117 : #f4f6f8;
    out property <color> field-background: root.dark ? #1a222c : #ffffff;
    out property <color> field-border: root.dark ? #29323d : #c5ccd5;
    out property <color> search-field-background: root.dark ? #171f29 : #ffffff;
    out property <color> search-field-border: root.dark ? #29333e : #c5ccd5;
    out property <color> text: root.dark ? #edf4fa : #141a21;
    out property <color> text-secondary: root.dark ? #8c99a9 : #5a6573;
    out property <color> text-muted: root.dark ? #727f8f : #6a7480;
    out property <color> placeholder: root.dark ? #717e8e : #7d8794;
    out property <color> accent: root.dark ? #62bfff : #1683d8;
    out property <color> button-label: root.dark ? #9aa6b5 : #4d5866;
    out property <color> button-label-hover: root.dark ? #71c5ff : #0b6fc0;
    out property <color> button-hover: root.dark ? #19222c : #e2e7ed;
    out property <color> button-pressed: root.dark ? #222d39 : #d3dae2;
    out property <color> tab-active: root.dark ? #161e28 : #ffffff;
    out property <color> tab-hover: root.dark ? #111820 : #dde3ea;
    out property <color> tab-title-inactive: root.dark ? #8b98a8 : #5a6573;
    out property <color> tab-close-hover: root.dark ? #222c37 : #d8dee6;
    out property <color> tab-close-pressed: root.dark ? #2b3744 : #c8d0da;
    out property <color> tab-close-label: root.dark ? #7f8c9c : #6a7480;
    out property <color> status-background: root.dark ? #1a222c : #ffffff;
    out property <color> status-border: root.dark ? #29323d : #c5ccd5;
    out property <color> status-text: root.dark ? #c9d3de : #2d3540;
    // A warning bar (the settings notice).
    out property <color> notice-background: root.dark ? #2a2212 : #fff4d6;
    out property <color> notice-border: root.dark ? #5c4a1f : #e8cf87;
    // An information bar (for example "restore your tabs?"); text on it uses `info-text`.
    out property <color> info-background: root.dark ? #10243a : #e6f2fd;
    out property <color> info-border: root.dark ? #1f4a70 : #9cc8f0;
    out property <color> info-text: root.dark ? #edf4fa : #141a21;

    // Popups and menus.
    out property <color> popup-background: root.dark ? #161e28 : #ffffff;
    out property <color> popup-border: root.dark ? #2b3744 : #c5ccd5;
    out property <color> item-hover: root.dark ? #1f2a36 : #e8edf3;
    out property <color> item-selected: root.dark ? #1d4f7a : #d4e7fb;
    out property <color> item-selected-text: root.dark ? #f4f9fd : #0b2a45;
    out property <color> separator: root.dark ? #29323d : #d6dce3;
    // A shortcut shown beside a menu item.
    out property <color> shortcut-text: root.dark ? #7f8c9c : #6a7480;
    out property <color> disabled-text: root.dark ? #5d6a7a : #9aa3ad;

    // Dialog sheets.
    // Laid over the page behind a sheet.
    out property <color> scrim: root.dark ? #00000099 : #0000004d;
    out property <color> sheet-background: root.dark ? #141b24 : #ffffff;
    out property <color> shadow: root.dark ? #00000080 : #00000040;
    out property <color> primary-button-background: root.dark ? #62bfff : #1683d8;
    out property <color> primary-button-text: root.dark ? #09131c : #ffffff;
    // Errors and destructive actions; readable as text on `sheet-background` and the windows.
    out property <color> danger: root.dark ? #ff9e94 : #b3261e;
    // The outline of the control that has keyboard focus.
    out property <color> focus-ring: root.dark ? #9fd8ff : #0b5fa5;

    // The part of a suggestion that matches what was typed.
    out property <color> match-highlight: root.dark ? #71c5ff : #0b6fc0;
}
