// Shared pieces of the UI for requests a page makes: dialogs, the leave prompt, sign-in and
// permission prompts. Colours follow the browser chrome in main-window.slint.

export enum PageRequestStyle {
    none,
    alert,
    confirm,
    prompt,
    leave-page,
    sign-in,
    permission,
}

// What the browser shows for the active tab's pending request. Every string is prepared by the
// browser; page-supplied text (the message, the prompt's default value) is plain text.
export struct PageRequestView {
    id: int,
    style: PageRequestStyle,
    heading: string,
    message: string,
    // Shown in a smaller, separate line: who asked, or that the connection is not secure.
    detail: string,
    // Shown in a warning colour (a sign-in over a connection that is not HTTPS).
    warning: string,
    // The prompt's default value, or a saved user name.
    value: string,
    // A saved password, if any.
    secret: string,
    accept-label: string,
    // Empty for an alert, which has only one button.
    decline-label: string,
    // The checkbox under the message: "Don't allow this page to show more dialogs" or
    // "Remember for this site". Empty for none.
    choice-label: string,
}

export component RequestButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    callback clicked;

    height: 30px;
    min-width: 84px;
    preferred-width: label-text.preferred-width + 32px;
    border-radius: 7px;
    border-width: root.primary ? 0px : 1px;
    border-color: #364556;
    background: root.primary
        ? (touch.pressed ? #45a9ed : touch.has-hover ? #78caff : #62bfff)
        : (touch.pressed ? #2b3744 : touch.has-hover ? #263241 : #1f2934);

    label-text := Text {
        text: root.label;
        color: root.primary ? #09131c : #edf4fa;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component RequestCheckBox inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;

    min-height: 22px;

    HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                border-width: 1px;
                border-color: root.checked ? #62bfff : #536375;
                background: root.checked ? #62bfff : #0f151c;

                if root.checked: Text {
                    text: "✓";
                    color: #09131c;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: root.label;
            color: #c9d3de;
            font-size: 12px;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
        }
    }
}

export component RequestField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password;
    // Select the whole text whenever the field gains focus (Slint does not on Tab on macOS).
    in property <bool> select-on-focus;
    out property <bool> has-focus: input.has-focus;
    callback accepted;

    public function focus-and-select() {
        input.focus();
        input.select-all();
    }

    height: 32px;
    border-radius: 7px;
    border-width: 1px;
    border-color: input.has-focus ? #62bfff : #2f3a47;
    background: #0f151c;

    if root.text == "": Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        color: #6b7888;
        font-size: 13px;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text <=> root.text;
        color: #edf4fa;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        input-type: root.password ? InputType.password : InputType.text;
        accepted => {
            root.accepted();
        }
        changed has-focus => {
            if self.has-focus && root.select-on-focus {
                self.select-all();
            }
        }
    }
}
