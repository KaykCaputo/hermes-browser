// A permission prompt hanging from the address bar: "<site> wants to …" with Block and Allow.
// The page stays visible and usable beneath it.

import {
    PageRequestView,
    RequestButton,
    RequestCheckBox,
} from "page-request-parts.slint";

export component PermissionPrompt inherits Rectangle {
    in property <PageRequestView> request;
    in property <bool> may-take-focus: true;
    // Where the address bar starts, relative to this element's parent.
    in property <length> anchor-x: 0px;
    // accepted: Allow; checked: remember the decision for the site.
    callback answered(/* id */ int, /* accepted */ bool, /* checked */ bool);

    property <int> shown-id: -1;
    property <bool> checked;

    function show-request() {
        if root.shown-id == root.request.id {
            return;
        }
        root.shown-id = root.request.id;
        root.checked = false;
        if root.may-take-focus {
            keys.focus();
        }
    }

    function answer(accepted: bool) {
        root.answered(root.request.id, accepted, root.checked);
    }

    init => {
        root.show-request();
    }

    changed request => {
        root.show-request();
    }

    // Fills the content area without taking input; only the bubble does.
    bubble := Rectangle {
    x: Math.max(8px, Math.min(root.anchor-x, root.width - self.width - 8px));
    y: 6px;
    width: Math.min(root.width - 16px, 380px);
    height: layout.preferred-height + 8px;

    // The arrow pointing at the address bar.
    Path {
        x: 22px;
        y: 0px;
        width: 16px;
        height: 9px;
        fill: #18212b;
        stroke: #3a4a5c;
        stroke-width: 1px;
        commands: "M 0 9 L 8 0 L 16 9";
    }

    Rectangle {
        y: 8px;
        height: parent.height - 8px;
        background: #18212b;
        border-width: 1px;
        border-color: #3a4a5c;
        border-radius: 10px;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000090;
        drop-shadow-offset-y: 4px;

        TouchArea { }

        keys := FocusScope {
            key-pressed(event) => {
                // Return does not grant a permission; only Escape (Block) has a key.
                if event.text == Key.Escape {
                    root.answer(false);
                    return accept;
                }
                reject
            }

            layout := VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: root.request.heading;
                    color: #edf4fa;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                if root.request.choice-label != "": RequestCheckBox {
                    label: root.request.choice-label;
                    checked <=> root.checked;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    RequestButton {
                        label: root.request.decline-label;
                        clicked => {
                            root.answer(false);
                        }
                    }

                    RequestButton {
                        label: root.request.accept-label;
                        primary: true;
                        clicked => {
                            root.answer(true);
                        }
                    }
                }
            }
        }
    }
    }
}
