import { Palette } from "std-widgets.slint";
import { ChromePalette } from "theme/chrome-palette.slint";
export { ChromePalette, ChromeTheme } from "theme/chrome-palette.slint";
// settings-ui
import { SettingsNotice } from "settings/settings-notice.slint";
export { SearchEngineRow, SettingsWindow } from "settings/settings-window.slint";
import { PageRequestSheet, PageRequestStyle, PageRequestView, PermissionPrompt } from "dialogs/page-requests.slint";
// controls
import { ColorPicker, ContextMenuPopup, ContextMenuRow, PopupBackdrop, SelectPopup, SelectPopupRow } from "controls/controls.slint";
import { PopUpBlockedIndicator } from "tabs/pop-up-blocked.slint";
// menus
import { AddressBarEdit, BrowserMenu, BrowserMenuCommand, BrowserMenuEntry } from "menus/browser-menu.slint";
export { AboutLink, AboutWindow } from "about/about-window.slint";

export enum WebViewPointerButton {
    left,
    middle,
    right,
    other,
}

export enum WebViewCursor {
    default,
    none,
    help,
    pointer,
    progress,
    wait,
    crosshair,
    text,
    alias,
    copy,
    move,
    no-drop,
    not-allowed,
    grab,
    grabbing,
    col-resize,
    row-resize,
    n-resize,
    e-resize,
    s-resize,
    w-resize,
    ne-resize,
    nw-resize,
    se-resize,
    sw-resize,
    ew-resize,
    ns-resize,
    nesw-resize,
    nwse-resize,
}

export struct BrowserTab {
    title: string,
    icon: image,
    has-icon: bool,
    active: bool,
    loading: bool,
}

component ChromeButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 36px;
    height: 34px;
    border-radius: 7px;
    background: button-area.pressed && root.enabled
        ? ChromePalette.button-pressed
        : button-area.has-hover && root.enabled ? ChromePalette.button-hover : transparent;
    opacity: root.enabled ? 1 : 0.32;

    Text {
        text: root.label;
        color: button-area.has-hover && root.enabled ? ChromePalette.button-label-hover : ChromePalette.button-label;
        font-size: 17px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-area := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

component TabIcon inherits Rectangle {
    in property <image> source;

    width: 18px;
    background: transparent;

    Image {
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.source;
        image-fit: contain;
    }
}

component BrowserTabButton inherits Rectangle {
    in property <BrowserTab> tab;
    in property <bool> closable;
    callback selected;
    callback closed;

    min-width: 112px;
    max-width: 248px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: root.tab.active
        ? ChromePalette.tab-active
        : tab-touch.has-hover ? ChromePalette.tab-hover : transparent;

    if root.tab.active: Rectangle {
        x: 14px;
        y: parent.height - 2px;
        width: parent.width - 28px;
        height: 2px;
        background: ChromePalette.accent;
    }

    tab-touch := TouchArea {
        clicked => {
            root.selected();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;

        if root.tab.has-icon: TabIcon {
            source: root.tab.icon;
        }

        if !root.tab.has-icon: TabIcon {
            source: @image-url("../../../apps/mercury-desktop/resources/mercury-browser.svg");
        }

        Text {
            horizontal-stretch: 1;
            text: root.tab.title;
            color: root.tab.active ? ChromePalette.text : ChromePalette.tab-title-inactive;
            font-size: 13px;
            font-weight: root.tab.active ? 550 : 450;
            overflow: elide;
            vertical-alignment: center;
        }

        if root.tab.loading: Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: ChromePalette.accent;
        }

        if root.closable: Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 6px;
            background: close-touch.pressed
                ? ChromePalette.tab-close-pressed
                : close-touch.has-hover ? ChromePalette.tab-close-hover : transparent;

            Text {
                text: "×";
                color: close-touch.has-hover ? ChromePalette.text : ChromePalette.tab-close-label;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            close-touch := TouchArea {
                clicked => {
                    root.closed();
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <[BrowserTab]> tabs;
    in property <int> active-tab-index: 0;
    in property <string> page-title: "New tab";
    in-out property <string> address: "";
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;
    in property <bool> is-loading: false;
    in property <bool> is-new-tab: true;
    in property <bool> web-view-visible: false;
    in property <image> web-view-texture;
    out property <length> web-view-width: web-view-area.width;
    out property <length> web-view-height: web-view-area.height;
    in property <string> content-message: "Type an address or search with DuckDuckGo.";
    in property <int> zoom-percent: 100;
    in property <WebViewCursor> web-view-cursor: WebViewCursor.default;
    in property <string> status-text: "";
    // The page is fullscreen: the tab strip and toolbar are hidden.
    in property <bool> chrome-hidden: false;
    out property <bool> text-input-focused: address-input.has-focus || (root.is-new-tab && root.new-tab-search-focused);
    out property <bool> web-view-hovered: web-view-input.has-hover;
    out property <float> web-view-pointer-x: web-view-input.mouse-x / 1px;
    out property <float> web-view-pointer-y: web-view-input.mouse-y / 1px;
    property <bool> new-tab-search-focused: false;
    // The window's colour scheme as Slint determined it, used when winit reports none.
    out property <ColorScheme> system-color-scheme: Palette.color-scheme;

    callback navigate(string);
    callback go-back;
    callback go-forward;
    callback reload;
    callback new-tab;
    callback select-tab(int);
    callback close-tab(int);
    callback web-view-pointer-moved(float, float);
    callback web-view-pointer-button(WebViewPointerButton, bool, float, float);
    callback web-view-scrolled(float, float, float, float);
    callback web-view-focus-changed(bool);
    callback web-view-pointer-left();
    // --- settings-ui ---
    in property <bool> show-home-button: false;
    // The zoom badge shows only when a page's zoom differs from this.
    in property <int> default-zoom-percent: 100;
    in property <string> search-engine-name: "DuckDuckGo";
    // One message about the settings file (damaged, or from a newer version); empty for none.
    in property <string> settings-notice: "";
    // Opens the settings window (Cmd+, and the menus).
    callback show-settings();
    callback go-home();
    callback dismiss-settings-notice();
    // --- end settings-ui ---

    // --- controls ---
    // Where the page area is in the window, for placing popups over page elements.
    out property <length> controls-page-x: web-view-area.absolute-position.x;
    out property <length> controls-page-y: web-view-area.absolute-position.y;
    // 0: none, 1: select list, 2: colour picker, 3: context menu.
    in property <int> controls-popup: 0;
    in property <length> controls-popup-x;
    in property <length> controls-popup-y;
    in property <length> controls-popup-width;
    in property <length> controls-popup-height;
    in property <string> controls-origin;
    in property <int> controls-highlighted: -1;
    in property <[SelectPopupRow]> controls-select-rows;
    in property <bool> controls-select-multiple;
    in-out property <length> controls-select-scroll-y;
    in property <[ContextMenuRow]> controls-menu-rows;
    in property <[color]> controls-color-swatches;
    in property <color> controls-color;
    in property <string> controls-color-hex;
    in property <bool> controls-color-hex-valid: true;
    in property <float> controls-color-hue;
    in property <float> controls-color-lightness;
    callback controls-dismissed();
    callback controls-row-clicked(int);
    callback controls-row-hovered(int);
    callback controls-select-done();
    callback controls-color-swatch-picked(int);
    callback controls-color-area-picked(float, float);
    callback controls-color-done();
    // The page area moved or was resized.
    callback controls-page-changed();
    changed controls-page-x => {
        root.controls-page-changed();
    }
    changed controls-page-y => {
        root.controls-page-changed();
    }
    changed web-view-width => {
        root.controls-page-changed();
    }
    changed web-view-height => {
        root.controls-page-changed();
    }
    // --- end controls ---

    pure function mouse-cursor-for(cursor: WebViewCursor) -> MouseCursor {
        if cursor == WebViewCursor.none {
            return MouseCursor.none;
        }
        if cursor == WebViewCursor.help {
            return MouseCursor.help;
        }
        if cursor == WebViewCursor.pointer {
            return MouseCursor.pointer;
        }
        if cursor == WebViewCursor.progress {
            return MouseCursor.progress;
        }
        if cursor == WebViewCursor.wait {
            return MouseCursor.wait;
        }
        if cursor == WebViewCursor.crosshair {
            return MouseCursor.crosshair;
        }
        if cursor == WebViewCursor.text {
            return MouseCursor.text;
        }
        if cursor == WebViewCursor.alias {
            return MouseCursor.alias;
        }
        if cursor == WebViewCursor.copy {
            return MouseCursor.copy;
        }
        if cursor == WebViewCursor.move {
            return MouseCursor.move;
        }
        if cursor == WebViewCursor.no-drop {
            return MouseCursor.no-drop;
        }
        if cursor == WebViewCursor.not-allowed {
            return MouseCursor.not-allowed;
        }
        if cursor == WebViewCursor.grab {
            return MouseCursor.grab;
        }
        if cursor == WebViewCursor.grabbing {
            return MouseCursor.grabbing;
        }
        if cursor == WebViewCursor.col-resize {
            return MouseCursor.col-resize;
        }
        if cursor == WebViewCursor.row-resize {
            return MouseCursor.row-resize;
        }
        if cursor == WebViewCursor.n-resize {
            return MouseCursor.n-resize;
        }
        if cursor == WebViewCursor.e-resize {
            return MouseCursor.e-resize;
        }
        if cursor == WebViewCursor.s-resize {
            return MouseCursor.s-resize;
        }
        if cursor == WebViewCursor.w-resize {
            return MouseCursor.w-resize;
        }
        if cursor == WebViewCursor.ne-resize {
            return MouseCursor.ne-resize;
        }
        if cursor == WebViewCursor.nw-resize {
            return MouseCursor.nw-resize;
        }
        if cursor == WebViewCursor.se-resize {
            return MouseCursor.se-resize;
        }
        if cursor == WebViewCursor.sw-resize {
            return MouseCursor.sw-resize;
        }
        if cursor == WebViewCursor.ew-resize {
            return MouseCursor.ew-resize;
        }
        if cursor == WebViewCursor.ns-resize {
            return MouseCursor.ns-resize;
        }
        if cursor == WebViewCursor.nesw-resize {
            return MouseCursor.nesw-resize;
        }
        if cursor == WebViewCursor.nwse-resize {
            return MouseCursor.nwse-resize;
        }
        return MouseCursor.default;
    }

    public function focus-address-bar() {
        address-input.focus();
        address-input.select-all();
    }

    public function reveal-active-tab() {
        tab-strip.viewport-x = Math.min(
            0px,
            Math.max(
                tab-strip.width - tab-strip.viewport-width,
                -root.active-tab-index * 190px,
            ),
        );
    }

    // --- tabs ---
    out property <bool> address-has-focus: address-input.has-focus;
    // The active tab's committed address; Escape in the address field restores it.
    in property <string> committed-address: "";

    public function reset-address(text: string) {
        root.address = text;
    }

    // The origin whose pop-up was blocked in the active tab; empty hides the indicator.
    in property <string> pop-up-blocked-origin: "";
    callback allow-pop-ups();
    callback dismiss-pop-up-blocked();
    // --- end tabs ---
    // --- dialogs ---
    // The active tab's oldest unanswered page request (style none when there is none).
    in property <PageRequestView> page-request;
    // id, accepted, text (prompt value or user name), password, checked ("Don't allow this page
    // to show more dialogs" or "... to ask again").
    callback page-request-answered(int, bool, string, string, bool);
    // --- end dialogs ---

    // --- menus ---
    // The browser menu's items above and below its zoom row (built in apps/mercury-desktop/src/menus).
    in property <[BrowserMenuEntry]> browser-menu-top-entries;
    in property <[BrowserMenuEntry]> browser-menu-bottom-entries;
    out property <bool> address-bar-focused: address-input.has-focus;
    callback browser-menu-activated(BrowserMenuCommand);
    // The address bar gained or lost keyboard focus: the Edit menu's enabled items change.
    callback address-bar-focus-changed(bool);
    changed address-bar-focused => {
        root.address-bar-focus-changed(self.address-bar-focused);
    }

    public function show-browser-menu() {
        browser-menu.show();
    }

    public function edit-address-bar(command: AddressBarEdit) {
        if !address-input.has-focus {
            return;
        }
        if command == AddressBarEdit.undo {
            address-input.undo();
        } else if command == AddressBarEdit.redo {
            address-input.redo();
        } else if command == AddressBarEdit.cut {
            address-input.cut();
        } else if command == AddressBarEdit.copy {
            address-input.copy();
        } else if command == AddressBarEdit.paste {
            address-input.paste();
        } else if command == AddressBarEdit.select-all {
            address-input.select-all();
        }
    }
    // --- end menus ---

    title: page-title + " — Mercury Browser";
    icon: @image-url("../../../apps/mercury-desktop/resources/mercury-browser.svg");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 0px;
    min-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    background: ChromePalette.window-background;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: root.chrome-hidden ? 0px : 48px;
            visible: !root.chrome-hidden;
            background: ChromePalette.window-background;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 14px;
                padding-top: 7px;
                padding-bottom: 3px;
                spacing: 8px;

                tab-strip := Flickable {
                    horizontal-stretch: 1;
                    viewport-width: Math.max(self.width, root.tabs.length * 190px);
                    viewport-height: self.height;

                    HorizontalLayout {
                        width: tab-strip.viewport-width;
                        spacing: 6px;

                        for tab[index] in root.tabs: BrowserTabButton {
                            width: 184px;
                            tab: tab;
                            closable: true;

                            selected => {
                                root.select-tab(index);
                            }

                            closed => {
                                root.close-tab(index);
                            }
                        }
                    }
                }

                ChromeButton {
                    width: 34px;
                    height: 34px;
                    label: "+";
                    clicked => {
                        root.new-tab();
                    }
                }
            }
        }

        Rectangle {
            height: root.chrome-hidden ? 0px : 60px;
            visible: !root.chrome-hidden;
            background: ChromePalette.toolbar-background;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 11px;
                padding-bottom: 11px;
                spacing: 8px;

                ChromeButton {
                    label: "‹";
                    enabled: root.can-go-back;
                    clicked => {
                        root.go-back();
                    }
                }

                ChromeButton {
                    label: "›";
                    enabled: root.can-go-forward;
                    clicked => {
                        root.go-forward();
                    }
                }

                ChromeButton {
                    label: "↻";
                    clicked => {
                        root.reload();
                    }
                }

                // settings-ui: the home button, when the appearance setting asks for it.
                if root.show-home-button: ChromeButton {
                    label: "⌂";
                    clicked => {
                        root.go-home();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: address-input.has-focus ? ChromePalette.accent : ChromePalette.field-border;
                    background: ChromePalette.field-background;

                    address-input := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: parent.height;
                        text <=> root.address;
                        color: ChromePalette.text;
                        font-size: 14px;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => {
                            // tabs: the page takes focus, so the field shows the committed URL
                            web-view-focus.focus();
                            if self.has-focus {
                                self.clear-focus();
                            }
                            root.navigate(self.text);
                        }
                        // tabs: Escape drops the draft and returns focus to the page
                        key-pressed(event) => {
                            if event.text != Key.Escape {
                                return reject;
                            }
                            // An input method's composition handles its own Escape.
                            if self.preedit-text != "" {
                                return reject;
                            }
                            // history lane: close the suggestion list here first, and accept.
                            root.reset-address(root.committed-address);
                            if root.web-view-visible {
                                web-view-focus.focus();
                            } else {
                                self.clear-focus();
                            }
                            accept
                        }
                    }
                }

                // tabs: a page's pop-up was blocked
                if root.pop-up-blocked-origin != "": PopUpBlockedIndicator {
                    origin: root.pop-up-blocked-origin;
                    allow => {
                        root.allow-pop-ups();
                    }
                    dismiss => {
                        root.dismiss-pop-up-blocked();
                    }
                }

                if root.zoom-percent != root.default-zoom-percent: Text {
                    text: root.zoom-percent + "%";
                    color: ChromePalette.button-label;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                browser-menu-button := ChromeButton {
                    label: "⋮";
                    clicked => { root.show-browser-menu(); }

                    // menus: the browser menu, below the button, right edges aligned. A child of the
                    // button, not placed with `absolute-position`: in Slint 1.17.1 that counts an
                    // element's offset twice when the element has a property lowered to an injected
                    // parent, such as ChromeButton's `opacity` (the `Opacity` parent takes the
                    // geometry: lower_property_to_element.rs:85, object_tree.rs:3441-3446).
                    // Measured: x 1700 for a button at 850.
                    browser-menu := BrowserMenu {
                        x: browser-menu-button.width - self.width;
                        y: browser-menu-button.height + 4px;
                        top-entries: root.browser-menu-top-entries;
                        bottom-entries: root.browser-menu-bottom-entries;
                        zoom-percent: root.zoom-percent;
                        activated(command) => {
                            root.browser-menu-activated(command);
                        }
                    }
                }
            }

            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: ChromePalette.toolbar-divider;
            }
        }

        // settings-ui: a message about the settings file.
        if root.settings-notice != "" && !root.chrome-hidden: SettingsNotice {
            text: root.settings-notice;
            dismissed => {
                root.dismiss-settings-notice();
            }
        }

        web-view-area := Rectangle {
            vertical-stretch: 1;
            background: ChromePalette.content-background;

            if root.web-view-visible: Image {
                width: parent.width;
                height: parent.height;
                source: root.web-view-texture;
                image-fit: fill;
            }

            if root.is-loading: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * 45%;
                height: 2px;
                background: ChromePalette.accent;
            }

            if root.is-new-tab: Rectangle {
                background: ChromePalette.content-background;

                new-tab-content := Rectangle {
                    width: parent.width < 640px ? parent.width - 48px : 580px;
                    height: 300px;
                    x: (parent.width - self.width) / 2;
                    y: Math.max(24px, (parent.height - self.height) / 2 - 24px);
                    background: transparent;

                    VerticalLayout {
                        spacing: 11px;

                        HorizontalLayout {
                            alignment: center;
                            height: 84px;

                            Image {
                                width: 80px;
                                height: 80px;
                                source: @image-url("../../../apps/mercury-desktop/resources/mercury-browser.svg");
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: "Mercury Browser";
                            color: ChromePalette.text;
                            font-size: 28px;
                            font-weight: 650;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Fast, lightweight and private by default";
                            color: ChromePalette.text-secondary;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }

                        Rectangle {
                            height: 48px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: new-tab-search.has-focus ? ChromePalette.accent : ChromePalette.search-field-border;
                            background: ChromePalette.search-field-background;

                            if new-tab-search.text == "": Text {
                                x: 18px;
                                width: parent.width - 82px;
                                height: parent.height;
                                text: "Search with " + root.search-engine-name + " or enter an address";
                                color: ChromePalette.placeholder;
                                font-size: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            new-tab-search := TextInput {
                                x: 18px;
                                width: parent.width - 82px;
                                height: parent.height;
                                color: ChromePalette.text;
                                font-size: 14px;
                                vertical-alignment: center;
                                single-line: true;

                                changed has-focus => {
                                    root.new-tab-search-focused = self.has-focus;
                                }

                                accepted => {
                                    root.navigate(self.text);
                                }
                            }

                            search-button := Rectangle {
                                x: parent.width - 52px;
                                y: 6px;
                                width: 42px;
                                height: 36px;
                                border-radius: 8px;
                                background: search-touch.pressed
                                    ? #45a9ed
                                    : search-touch.has-hover ? #78caff : #62bfff;

                                Text {
                                    text: "→";
                                    color: #09131c;
                                    font-size: 20px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                search-touch := TouchArea {
                                    clicked => {
                                        root.navigate(new-tab-search.text);
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.content-message;
                            color: ChromePalette.text-muted;
                            font-size: 12px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if !root.web-view-visible && !root.is-new-tab: VerticalLayout {
                alignment: center;
                spacing: 10px;
                padding-left: 32px;
                padding-right: 32px;

                Text {
                    text: root.content-message;
                    color: ChromePalette.text-secondary;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            web-view-focus := FocusScope {
                enabled: root.web-view-visible;
                focus-on-click: false;
                focus-on-tab-navigation: false;

                focus-gained => {
                    root.web-view-focus-changed(true);
                }

                focus-lost => {
                    root.web-view-focus-changed(false);
                }

                web-view-input := TouchArea {
                    enabled: root.web-view-visible;
                    mouse-cursor: root.mouse-cursor-for(root.web-view-cursor);

                    changed has-hover => {
                        if !self.has-hover {
                            root.web-view-pointer-left();
                        }
                    }

                    property <WebViewPointerButton> active-button: WebViewPointerButton.other;

                    function map-pointer-button(
                        button: PointerEventButton,
                    ) -> WebViewPointerButton {
                        if button == PointerEventButton.left {
                            return WebViewPointerButton.left;
                        }

                        if button == PointerEventButton.middle {
                            return WebViewPointerButton.middle;
                        }

                        if button == PointerEventButton.right {
                            return WebViewPointerButton.right;
                        }

                        return WebViewPointerButton.other;
                    }

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move {
                            root.web-view-pointer-moved(
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );
                        } else if event.kind == PointerEventKind.down {
                            web-view-focus.focus();
                            self.active-button = self.map-pointer-button(event.button);

                            root.web-view-pointer-button(
                                self.active-button,
                                true,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );
                        } else if event.kind == PointerEventKind.up {
                            root.web-view-pointer-button(
                                self.map-pointer-button(event.button),
                                false,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );

                            self.active-button = WebViewPointerButton.other;
                        } else if event.kind == PointerEventKind.cancel {
                            root.web-view-pointer-button(
                                self.active-button,
                                false,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );

                            self.active-button = WebViewPointerButton.other;
                        }
                    }

                    scroll-event(event) => {
                        root.web-view-scrolled(
                            event.delta-x / 1px,
                            event.delta-y / 1px,
                            self.mouse-x / 1px,
                            self.mouse-y / 1px,
                        );

                        accept
                    }
                }
            }

            // Drawn above the page; plain Rectangle and Text items do not take pointer input.
            if root.web-view-visible && root.web-view-hovered && root.status-text != "": Rectangle {
                x: 6px;
                y: parent.height - self.height - 6px;
                width: Math.min(status-label.preferred-width + 16px, parent.width * 60%);
                height: 24px;
                border-radius: 6px;
                border-width: 1px;
                border-color: ChromePalette.status-border;
                background: ChromePalette.status-background;

                status-label := Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: root.status-text;
                    color: ChromePalette.status-text;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    wrap: no-wrap;
                }
            }

            // dialogs
            if root.page-request.style != PageRequestStyle.none && root.page-request.style != PageRequestStyle.permission: PageRequestSheet {
                request: root.page-request;
                may-take-focus: !root.text-input-focused;
                answered(id, accepted, text, password, checked) => {
                    root.page-request-answered(id, accepted, text, password, checked);
                }
            }

            // dialogs
            if root.page-request.style == PageRequestStyle.permission: PermissionPrompt {
                request: root.page-request;
                anchor-x: address-input.absolute-position.x - 14px - web-view-area.absolute-position.x;
                answered(id, accepted) => {
                    root.page-request-answered(id, accepted, "", "", false);
                }
            }
        }
    }

    // controls
    if root.controls-popup != 0: PopupBackdrop {
        dismissed => {
            root.controls-dismissed();
        }
    }

    // controls
    if root.controls-popup == 1: SelectPopup {
        x: root.controls-popup-x;
        y: root.controls-popup-y;
        width: root.controls-popup-width;
        height: root.controls-popup-height;
        rows: root.controls-select-rows;
        highlighted: root.controls-highlighted;
        multiple: root.controls-select-multiple;
        origin: root.controls-origin;
        scroll-y <=> root.controls-select-scroll-y;
        row-clicked(index) => {
            root.controls-row-clicked(index);
        }
        row-hovered(index) => {
            root.controls-row-hovered(index);
        }
        done => {
            root.controls-select-done();
        }
    }

    // controls
    if root.controls-popup == 2: ColorPicker {
        x: root.controls-popup-x;
        y: root.controls-popup-y;
        width: root.controls-popup-width;
        height: root.controls-popup-height;
        origin: root.controls-origin;
        swatches: root.controls-color-swatches;
        current: root.controls-color;
        hex: root.controls-color-hex;
        hex-valid: root.controls-color-hex-valid;
        hue: root.controls-color-hue;
        lightness: root.controls-color-lightness;
        swatch-picked(index) => {
            root.controls-color-swatch-picked(index);
        }
        area-picked(hue, lightness) => {
            root.controls-color-area-picked(hue, lightness);
        }
        done => {
            root.controls-color-done();
        }
        cancelled => {
            root.controls-dismissed();
        }
    }

    // controls
    if root.controls-popup == 3: ContextMenuPopup {
        x: root.controls-popup-x;
        y: root.controls-popup-y;
        width: root.controls-popup-width;
        height: root.controls-popup-height;
        rows: root.controls-menu-rows;
        highlighted: root.controls-highlighted;
        row-clicked(index) => {
            root.controls-row-clicked(index);
        }
        row-hovered(index) => {
            root.controls-row-hovered(index);
        }
    }

    // menus: keeps Slint's default macOS menu bar out; Mercury installs its own native menu.
    MenuBar {
        visible: false;
        Menu { }
    }
}
