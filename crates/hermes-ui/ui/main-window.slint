export enum WebViewPointerButton {
    left,
    middle,
    right,
    other,
}

export struct BrowserTab {
    title: string,
    icon: image,
    has-icon: bool,
    active: bool,
    loading: bool,
}

component ChromeButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 36px;
    height: 34px;
    border-radius: 7px;
    background: button-area.pressed && root.enabled
        ? #222d39
        : button-area.has-hover && root.enabled ? #19222c : transparent;
    opacity: root.enabled ? 1 : 0.32;

    Text {
        text: root.label;
        color: button-area.has-hover && root.enabled ? #71c5ff : #9aa6b5;
        font-size: 17px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-area := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

component TabIcon inherits Rectangle {
    in property <image> source;

    width: 18px;
    background: transparent;

    Image {
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.source;
        image-fit: contain;
    }
}

component BrowserTabButton inherits Rectangle {
    in property <BrowserTab> tab;
    in property <bool> closable;
    callback selected;
    callback closed;

    min-width: 112px;
    max-width: 248px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: root.tab.active
        ? #161e28
        : tab-touch.has-hover ? #111820 : transparent;

    if root.tab.active: Rectangle {
        x: 14px;
        y: parent.height - 2px;
        width: parent.width - 28px;
        height: 2px;
        background: #62bfff;
    }

    tab-touch := TouchArea {
        clicked => {
            root.selected();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;

        if root.tab.has-icon: TabIcon {
            source: root.tab.icon;
        }

        if !root.tab.has-icon: TabIcon {
            source: @image-url("../../../apps/hermes-desktop/resources/hermes-browser.svg");
        }

        Text {
            horizontal-stretch: 1;
            text: root.tab.title;
            color: root.tab.active ? #edf4fa : #8b98a8;
            font-size: 13px;
            font-weight: root.tab.active ? 550 : 450;
            overflow: elide;
            vertical-alignment: center;
        }

        if root.tab.loading: Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #62bfff;
        }

        if root.closable: Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 6px;
            background: close-touch.pressed
                ? #2b3744
                : close-touch.has-hover ? #222c37 : transparent;

            Text {
                text: "×";
                color: close-touch.has-hover ? #edf4fa : #7f8c9c;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            close-touch := TouchArea {
                clicked => {
                    root.closed();
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <[BrowserTab]> tabs;
    in property <int> active-tab-index: 0;
    in property <string> page-title: "New tab";
    in-out property <string> address: "";
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;
    in property <bool> is-loading: false;
    in property <bool> is-new-tab: true;
    in property <bool> web-view-visible: false;
    out property <length> web-view-width: web-view-area.width;
    out property <length> web-view-height: web-view-area.height;
    in property <string> content-message: "Type an address or search with DuckDuckGo.";

    callback navigate(string);
    callback go-back;
    callback go-forward;
    callback reload;
    callback new-tab;
    callback select-tab(int);
    callback close-tab(int);
    callback web-view-pointer-moved(float, float);
    callback web-view-pointer-button(WebViewPointerButton, bool, float, float);
    callback web-view-scrolled(float, float, float, float);
    callback web-view-focus-changed(bool);

    public function focus-address-bar() {
        address-input.focus();
        address-input.select-all();
    }

    public function reveal-active-tab() {
        tab-strip.viewport-x = Math.min(
            0px,
            Math.max(
                tab-strip.width - tab-strip.viewport-width,
                -root.active-tab-index * 190px,
            ),
        );
    }

    title: page-title + " — Hermes Browser";
    icon: @image-url("../../../apps/hermes-desktop/resources/hermes-browser.svg");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 480px;
    min-height: 480px;
    background: #0b0f14;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 48px;
            background: #0b0f14;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 14px;
                padding-top: 7px;
                padding-bottom: 3px;
                spacing: 8px;

                tab-strip := Flickable {
                    horizontal-stretch: 1;
                    viewport-width: Math.max(self.width, root.tabs.length * 190px);
                    viewport-height: self.height;

                    HorizontalLayout {
                        width: tab-strip.viewport-width;
                        spacing: 6px;

                        for tab[index] in root.tabs: BrowserTabButton {
                            width: 184px;
                            tab: tab;
                            closable: root.tabs.length > 1;

                            selected => {
                                root.select-tab(index);
                            }

                            closed => {
                                root.close-tab(index);
                            }
                        }
                    }
                }

                ChromeButton {
                    width: 34px;
                    height: 34px;
                    label: "+";
                    clicked => {
                        root.new-tab();
                    }
                }
            }
        }

        Rectangle {
            height: 60px;
            background: #11171f;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 11px;
                padding-bottom: 11px;
                spacing: 8px;

                ChromeButton {
                    label: "‹";
                    enabled: root.can-go-back;
                    clicked => {
                        root.go-back();
                    }
                }

                ChromeButton {
                    label: "›";
                    enabled: root.can-go-forward;
                    clicked => {
                        root.go-forward();
                    }
                }

                ChromeButton {
                    label: "↻";
                    clicked => {
                        root.reload();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: address-input.has-focus ? #62bfff : #29323d;
                    background: #1a222c;

                    address-input := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: parent.height;
                        text <=> root.address;
                        color: #edf4fa;
                        font-size: 14px;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => {
                            root.navigate(self.text);
                        }
                    }
                }

                ChromeButton {
                    label: "⋮";
                }
            }

            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: #202832;
            }
        }

        web-view-area := Rectangle {
            vertical-stretch: 1;
            background: root.web-view-visible ? transparent : #0c1117;

            if root.is-loading: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * 45%;
                height: 2px;
                background: #62bfff;
            }

            if root.is-new-tab: Rectangle {
                background: #0c1117;

                new-tab-content := Rectangle {
                    width: parent.width < 640px ? parent.width - 48px : 580px;
                    height: 300px;
                    x: (parent.width - self.width) / 2;
                    y: Math.max(24px, (parent.height - self.height) / 2 - 24px);
                    background: transparent;

                    VerticalLayout {
                        spacing: 11px;

                        HorizontalLayout {
                            alignment: center;
                            height: 84px;

                            Image {
                                width: 80px;
                                height: 80px;
                                source: @image-url("../../../apps/hermes-desktop/resources/hermes-browser.svg");
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: "Hermes Browser";
                            color: #edf4fa;
                            font-size: 28px;
                            font-weight: 650;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Fast, lightweight and private by default";
                            color: #8c99a9;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }

                        Rectangle {
                            height: 48px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: new-tab-search.has-focus ? #62bfff : #29333e;
                            background: #171f29;

                            if new-tab-search.text == "": Text {
                                x: 18px;
                                width: parent.width - 82px;
                                height: parent.height;
                                text: "Search with DuckDuckGo or enter an address";
                                color: #717e8e;
                                font-size: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            new-tab-search := TextInput {
                                x: 18px;
                                width: parent.width - 82px;
                                height: parent.height;
                                color: #edf4fa;
                                font-size: 14px;
                                vertical-alignment: center;
                                single-line: true;

                                accepted => {
                                    root.navigate(self.text);
                                }
                            }

                            search-button := Rectangle {
                                x: parent.width - 52px;
                                y: 6px;
                                width: 42px;
                                height: 36px;
                                border-radius: 8px;
                                background: search-touch.pressed
                                    ? #45a9ed
                                    : search-touch.has-hover ? #78caff : #62bfff;

                                Text {
                                    text: "→";
                                    color: #09131c;
                                    font-size: 20px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                search-touch := TouchArea {
                                    clicked => {
                                        root.navigate(new-tab-search.text);
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.content-message;
                            color: #727f8f;
                            font-size: 12px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if !root.web-view-visible && !root.is-new-tab: VerticalLayout {
                alignment: center;
                spacing: 10px;
                padding-left: 32px;
                padding-right: 32px;

                Text {
                    text: root.content-message;
                    color: #8c99a9;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            web-view-focus := FocusScope {
                enabled: root.web-view-visible;
                focus-on-click: false;
                focus-on-tab-navigation: false;

                focus-gained => {
                    root.web-view-focus-changed(true);
                }

                focus-lost => {
                    root.web-view-focus-changed(false);
                }

                web-view-input := TouchArea {
                    enabled: root.web-view-visible;

                    property <WebViewPointerButton> active-button: WebViewPointerButton.other;

                    function map-pointer-button(
                        button: PointerEventButton,
                    ) -> WebViewPointerButton {
                        if button == PointerEventButton.left {
                            return WebViewPointerButton.left;
                        }

                        if button == PointerEventButton.middle {
                            return WebViewPointerButton.middle;
                        }

                        if button == PointerEventButton.right {
                            return WebViewPointerButton.right;
                        }

                        return WebViewPointerButton.other;
                    }

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move {
                            root.web-view-pointer-moved(
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );
                        } else if event.kind == PointerEventKind.down {
                            web-view-focus.focus();
                            self.active-button = self.map-pointer-button(event.button);

                            root.web-view-pointer-button(
                                self.active-button,
                                true,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );
                        } else if event.kind == PointerEventKind.up {
                            root.web-view-pointer-button(
                                self.map-pointer-button(event.button),
                                false,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );

                            self.active-button = WebViewPointerButton.other;
                        } else if event.kind == PointerEventKind.cancel {
                            root.web-view-pointer-button(
                                self.active-button,
                                false,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );

                            self.active-button = WebViewPointerButton.other;
                        }
                    }

                    scroll-event(event) => {
                        root.web-view-scrolled(
                            event.delta-x / 1px,
                            event.delta-y / 1px,
                            self.mouse-x / 1px,
                            self.mouse-y / 1px,
                        );

                        accept
                    }
                }
            }
        }
    }
}
