export global ChromeTheme {
    in property <int> mode: 0;
    in property <bool> system-light;
    out property <bool> light: mode == 1 || (mode == 0 && system-light);
}

export struct AddressSuggestion {
    label: string,
    address: string,
    tab-index: int,
}

export struct BookmarkTile {
    address: string,
    label: string,
    initial: string,
}

export enum WebViewPointerButton {
    left,
    middle,
    right,
    other,
}

export struct BrowserTab {
    title: string,
    pinned: bool,
    media-playing: bool,
    media-muted: bool,
    icon: image,
    has-icon: bool,
    active: bool,
    loading: bool,
}

component ChromeButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> highlighted;
    in property <length> label-size: 17px;
    callback clicked;

    border-width: keyboard.has-focus ? 1px : 0px;
    border-color: ChromeTheme.light ? #1469a7 : #62bfff;
    keyboard := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    preferred-width: 36px;
    height: 34px;
    border-radius: 7px;
    background: button-area.pressed && root.enabled
        ? (ChromeTheme.light ? #cddceb : #222d39)
        : (button-area.has-hover || root.highlighted) && root.enabled ? (ChromeTheme.light ? #dbe6f1 : #19222c) : transparent;
    opacity: root.enabled ? 1 : 0.32;

    Text {
        text: root.label;
        color: button-area.has-hover && root.enabled ? (ChromeTheme.light ? #125f98 : #71c5ff) : (ChromeTheme.light ? #40536a : #9aa6b5);
        font-size: root.label-size;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-area := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

component ActionButton inherits ChromeButton {
    preferred-width: 72px;
    min-width: 24px;
    height: 30px;
    horizontal-stretch: 1;
    label-size: 13px;
    accessible-label: self.label;
}

component TabIcon inherits Rectangle {
    in property <image> source;

    width: 18px;
    background: transparent;

    Image {
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.source;
        image-fit: contain;
    }
}

component BrowserTabButton inherits Rectangle {
    in property <BrowserTab> tab;
    in property <bool> closable;
    callback selected;
    callback closed;
    callback dragged(int);
    callback toggle-pin;
    callback toggle-mute;
    in property <bool> vertical;
    in property <bool> collapsed;
    in property <length> tab-step: 190px;

    min-width: root.collapsed || (root.tab.pinned && !root.vertical) ? 40px : 112px;
    max-width: 248px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: root.tab.active
        ? (ChromeTheme.light ? #f7f9fc : #11171f)
        : tab-touch.has-hover ? (ChromeTheme.light ? #dbe6f1 : #111820) : transparent;

    if !root.tab.active && !tab-touch.has-hover: Rectangle {
        x: parent.width - 1px;
        y: 9px;
        width: 1px;
        height: parent.height - 18px;
        background: (ChromeTheme.light ? #c7d3e1 : #29323d);
    }

    tab-touch := TouchArea {
        property <length> start;
        property <bool> drag-ended;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.start = root.vertical ? self.mouse-y : self.mouse-x;
                self.drag-ended = false;
            } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                let delta = (root.vertical ? self.mouse-y : self.mouse-x) - self.start;
                let steps = Math.round(delta / root.tab-step);
                if steps != 0 {
                    self.drag-ended = true;
                    root.dragged(steps);
                }
            }
        }
        clicked => {
            if !self.drag-ended { root.selected(); }
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;

        if root.tab.has-icon: TabIcon {
            source: root.tab.icon;
        }

        if !root.tab.has-icon: TabIcon {
            source: @image-url("../../../apps/hermes-desktop/resources/hermes-browser.svg");
        }

        if !root.collapsed && (!root.tab.pinned || root.vertical): Text {
            horizontal-stretch: 1;
            text: root.tab.title;
            color: root.tab.active ? (ChromeTheme.light ? #142337 : #edf4fa) : (ChromeTheme.light ? #4a5e75 : #8b98a8);
            font-size: 13px;
            font-weight: root.tab.active ? 550 : 450;
            overflow: elide;
            vertical-alignment: center;
        }

        if !root.collapsed && (!root.tab.pinned || root.vertical) && (root.tab.media-playing || root.tab.media-muted): ChromeButton {
            width: 24px;
            height: 24px;
            label: root.tab.media-muted ? "♬̸" : "♬";
            accessible-label: root.tab.media-muted ? "Unmute tab media" : "Mute tab media";
            clicked => { root.toggle-mute(); }
        }

        if root.tab.loading: Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: (ChromeTheme.light ? #1469a7 : #62bfff);
        }

        if !root.collapsed && root.closable && (!root.tab.pinned || root.vertical): Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 6px;
            background: close-touch.pressed
                ? (ChromeTheme.light ? #c9daec : #2b3744)
                : close-touch.has-hover ? (ChromeTheme.light ? #dce7f2 : #222c37) : transparent;

            Text {
                text: "×";
                color: close-touch.has-hover ? (ChromeTheme.light ? #142337 : #edf4fa) : (ChromeTheme.light ? #51667e : #7f8c9c);
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            close-touch := TouchArea {
                clicked => {
                    root.closed();
                }
            }
        }
    }
    ContextMenuArea {
        Menu {
            MenuItem {
                title: root.tab.pinned ? "Unpin tab" : "Pin tab";
                activated => { root.toggle-pin(); }
            }
            MenuItem {
                title: root.tab.media-muted ? "Unmute tab media" : "Mute tab media";
                enabled: root.tab.media-playing || root.tab.media-muted;
                activated => { root.toggle-mute(); }
            }
            MenuItem {
                title: "Close tab";
                enabled: root.closable;
                activated => { root.closed(); }
            }
        }
    }

}

export component MainWindow inherits Window {
    in property <[BrowserTab]> tabs;
    in property <int> active-tab-index: 0;
    in property <string> page-title: "New tab";
    in-out property <string> address: "";
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;
    in property <bool> is-loading: false;
    in property <bool> is-new-tab: true;
    in property <bool> web-view-visible: false;
    in property <image> web-view-texture;
    out property <length> web-view-width: web-view-area.width;
    out property <length> web-view-height: web-view-area.height;
    in property <string> content-message: "Type an address or search with DuckDuckGo.";

    in property <bool> page-fullscreen;
    in property <bool> user-fullscreen;
    in property <string> committed-address;
    in property <string> displayed-tab;
    in property <[BookmarkTile]> bookmarks;
    in property <bool> profile-available;
    in property <bool> is-bookmarked;
    in property <int> blocked-requests;
    in property <string> site-host;
    in property <bool> site-https;
    in property <bool> shield-paused;
    callback open-site-panel();
    callback toggle-shield();
    callback browser-action(string);
    in property <bool> new-tab-gradient;
    in property <[AddressSuggestion]> suggestions;
    in-out property <int> selected-suggestion: -1;
    out property <bool> address-focused: address-input.has-focus;
    callback address-edited(string);

    public function accept-suggestion(index: int) {
        if index >= 0 && index < root.suggestions.length {
            if root.suggestions[index].tab-index >= 0 {
                root.select-tab(root.suggestions[index].tab-index);
                root.focus-web-content();
            } else {
                root.navigate(root.suggestions[index].address);
            }
            root.address-edited("");
        }
    }
    callback appearance-changed(int, bool);
    callback toggle-bookmark();
    callback remove-bookmark(string);
    callback navigate(string);
    callback go-back;
    callback go-forward;
    callback reload;
    callback new-tab;
    callback select-tab(int);
    callback close-tab(int);
    callback move-tab(int, int);
    callback toggle-tab-pin(int);
    callback toggle-tab-mute(int);
    in property <bool> vertical-tabs;
    in property <bool> collapsed-tabs;
    callback tab-layout-changed(bool, bool);
    in property <int> pinned-tabs;
    callback web-view-pointer-moved(float, float);
    callback web-view-pointer-button(WebViewPointerButton, bool, float, float);
    callback web-view-scrolled(float, float, float, float);
    callback web-view-focus-changed(bool);

    public function focus-web-content() {
        web-view-focus.focus();
    }

    public function focus-address-bar() {
        root.address-edited("");
        address-input.focus();
        address-input.select-all();
    }

    public function reveal-active-tab() {
        if root.vertical-tabs {
            let offset = root.active-tab-index * 38px;
            if offset < -side-tabs.viewport-y {
                side-tabs.viewport-y = -offset;
            } else if offset + 38px > side-tabs.height - side-tabs.viewport-y {
                side-tabs.viewport-y = side-tabs.height - offset - 38px;
            }
            return;
        }
        tab-strip.viewport-x = Math.min(
            0px,
            Math.max(
                tab-strip.width - tab-strip.viewport-width,
                -(Math.min(root.active-tab-index, root.pinned-tabs) * 46px
                    + Math.max(0, root.active-tab-index - root.pinned-tabs) * 190px),
            ),
        );
    }

    title: page-title + " — Hermes Browser";
    icon: @image-url("../../../apps/hermes-desktop/resources/hermes-browser.svg");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 0px;
    min-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    background: (ChromeTheme.light ? #e9eff7 : #0b0f14);

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            visible: !root.page-fullscreen && !root.vertical-tabs;
            height: root.page-fullscreen || root.vertical-tabs ? 0px : 38px;
            background: (ChromeTheme.light ? #e9eff7 : #0b0f14);

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 14px;
                padding-top: 4px;
                padding-bottom: 0px;
                spacing: 8px;

                tab-strip := Flickable {
                    horizontal-stretch: 1;
                    viewport-width: Math.max(self.width, root.pinned-tabs * 46px + (root.tabs.length - root.pinned-tabs) * 190px);
                    interactive: false;
                    viewport-height: self.height;

                    TouchArea {
                        width: tab-strip.width;
                        height: tab-strip.height;
                        scroll-event(event) => {
                            tab-strip.viewport-x = Math.min(0px, Math.max(
                                tab-strip.width - tab-strip.viewport-width,
                                tab-strip.viewport-x + (event.delta-x != 0 ? event.delta-x : event.delta-y)
                            ));
                            accept
                        }
                    }
                    HorizontalLayout {
                        width: tab-strip.viewport-width;
                        spacing: 6px;

                        for tab[index] in root.tabs: BrowserTabButton {
                            width: tab.pinned ? 40px : 184px;
                            tab-step: tab.pinned ? 46px : 190px;
                            toggle-pin => { root.toggle-tab-pin(index); }
                            toggle-mute => { root.toggle-tab-mute(index); }
                            tab: tab;
                            closable: root.tabs.length > 1;

                            selected => {
                                root.select-tab(index);
                            }

                            closed => { root.close-tab(index); }
                            dragged(steps) => { root.move-tab(index, Math.max(0, Math.min(root.tabs.length - 1, index + steps))); }
                        }
                    }
                }

                ChromeButton {
                    width: 34px;
                    height: 34px;
                    label: "+";
                    accessible-label: "New tab";
                    clicked => {
                        root.new-tab();
                    }
                }
            }
        }

        Rectangle {
            visible: !root.page-fullscreen;
            height: root.page-fullscreen ? 0px : 46px;
            background: (ChromeTheme.light ? #f7f9fc : #11171f);

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 8px;

                ChromeButton {
                    label: "‹";
                    accessible-label: "Back";
                    enabled: root.can-go-back;
                    clicked => {
                        root.go-back();
                    }
                }

                ChromeButton {
                    label: "›";
                    accessible-label: "Forward";
                    enabled: root.can-go-forward;
                    clicked => {
                        root.go-forward();
                    }
                }

                ChromeButton {
                    label: "↻";
                    accessible-label: "Reload";
                    clicked => {
                        root.reload();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 34px;
                    border-radius: 17px;
                    border-width: 1px;
                    border-color: address-input.has-focus ? (ChromeTheme.light ? #1469a7 : #62bfff) : (ChromeTheme.light ? #c7d3e1 : #29323d);
                    background: (ChromeTheme.light ? #e9eff7 : #1a222c);

                    ChromeButton {
                        x: 0px;
                        y: 0px;
                        width: 34px;
                        label: "ⓘ";
                        enabled: !root.is-new-tab;
                        accessible-label: "Site information";
                        clicked => { root.open-site-panel(); site-panel.show(); }
                    }

                    address-input := TextInput {
                        accessible-label: "Address or search";
                        x: 38px;
                        width: parent.width - 48px;
                        height: parent.height;
                        text <=> root.address;
                        color: (ChromeTheme.light ? #142337 : #edf4fa);
                        font-size: 14px;
                        vertical-alignment: center;
                        single-line: true;
                        edited => { root.address-edited(self.text); }
                        accepted => {
                            if root.selected-suggestion >= 0 {
                                root.accept-suggestion(root.selected-suggestion);
                            } else {
                                root.address-edited("");
                                root.navigate(self.text);
                            }
                        }
                    }
                }

                ChromeButton {
                    label: root.is-bookmarked ? "★" : "☆";
                    accessible-label: root.is-bookmarked ? "Remove bookmark" : "Bookmark this page";
                    enabled: root.profile-available && !root.is-new-tab;
                    clicked => { root.toggle-bookmark(); }
                }

                ChromeButton {
                    label: root.blocked-requests > 0 ? "⛨ " + root.blocked-requests : "⛨";
                    width: root.blocked-requests > 0 ? 52px : 34px;
                    enabled: !root.is-new-tab;
                    accessible-label: "Ad and tracker blocking";
                    clicked => { root.open-site-panel(); site-panel.show(); }
                }

                ChromeButton {
                    label: "⋮";
                    accessible-label: "Browser menu";
                    clicked => { browser-menu.show(); }
                }
            }

            browser-menu := PopupWindow {
                x: Math.max(0px, root.width - 248px);
                y: 44px;
                width: 232px;
                height: 244px;
                Rectangle {
                    background: (ChromeTheme.light ? #ffffff : #171f29);
                    border-color: (ChromeTheme.light ? #b4c4d7 : #344454);
                    border-width: 1px;
                    border-radius: 12px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 5px;
                        ActionButton { label: "New tab"; clicked => { browser-menu.close(); root.new-tab(); } }
                        ActionButton { label: "Reopen closed tab"; clicked => { browser-menu.close(); root.browser-action("reopen"); } }
                        HorizontalLayout {
                            spacing: 4px;
                            ActionButton { label: "−"; accessible-label: "Zoom out"; clicked => { root.browser-action("zoom-out"); } }
                            ActionButton { label: "Reset zoom"; clicked => { root.browser-action("zoom-reset"); } }
                            ActionButton { label: "+"; accessible-label: "Zoom in"; clicked => { root.browser-action("zoom-in"); } }
                        }
                        ActionButton {
                            label: root.vertical-tabs ? "Use horizontal tabs" : "Use vertical tabs";
                            clicked => { browser-menu.close(); root.tab-layout-changed(!root.vertical-tabs, root.collapsed-tabs); }
                        }
                        ActionButton { label: root.user-fullscreen ? "Exit fullscreen" : "Fullscreen"; clicked => { browser-menu.close(); root.browser-action("fullscreen"); } }
                    }
                }
            }
            site-panel := PopupWindow {
                x: Math.max(0px, root.width - 300px);
                y: 44px;
                width: 284px;
                height: 142px;
                Rectangle {
                    background: (ChromeTheme.light ? #ffffff : #171f29);
                    border-color: (ChromeTheme.light ? #b4c4d7 : #344454);
                    border-width: 1px;
                    border-radius: 12px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 6px;
                        Text {
                            text: root.site-host == "" ? "Site information" : root.site-host;
                            font-weight: 650;
                            color: (ChromeTheme.light ? #142337 : #edf4fa);
                            overflow: elide;
                        }
                        Text {
                            text: root.site-host == "" ? "Internal page" : root.site-https ? "HTTPS connection" : "Unencrypted HTTP connection";
                            color: (ChromeTheme.light ? #40536a : #a4b2bf);
                        }
                        if root.site-host != "": Text {
                            text: root.shield-paused ? "Blocking paused for this site" : "Requests blocked on this page: " + root.blocked-requests;
                            color: (ChromeTheme.light ? #40536a : #a4b2bf);
                        }
                        if root.site-host != "": ActionButton {
                            label: root.shield-paused ? "Resume and reload" : "Pause and reload";
                            accessible-label: self.label;
                            clicked => { site-panel.close(); root.toggle-shield(); }
                        }
                    }
                }
            }
            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: (ChromeTheme.light ? #cfdae7 : #202832);
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            Rectangle {
                visible: root.vertical-tabs && !root.page-fullscreen;
                width: !self.visible ? 0px : root.collapsed-tabs ? 50px : 208px;
                background: ChromeTheme.light ? #e9eff7 : #0b0f14;

                VerticalLayout {
                    padding: 4px;
                    spacing: 3px;
                    ChromeButton {
                        width: 42px;
                        label: root.collapsed-tabs ? "›" : "‹";
                        accessible-label: root.collapsed-tabs ? "Expand tab sidebar" : "Collapse tab sidebar";
                        clicked => { root.tab-layout-changed(true, !root.collapsed-tabs); }
                    }
                    side-tabs := Flickable {
                        vertical-stretch: 1;
                        viewport-height: root.tabs.length * 38px;
                        viewport-width: self.width;
                        interactive: false;
                        TouchArea {
                            width: side-tabs.width;
                            height: side-tabs.height;
                            scroll-event(event) => {
                                side-tabs.viewport-y = Math.min(0px, Math.max(
                                    side-tabs.height - side-tabs.viewport-height,
                                    side-tabs.viewport-y + event.delta-y
                                ));
                                accept
                            }
                        }
                        for tab[index] in root.tabs: BrowserTabButton {
                            x: 0px;
                            y: index * 38px;
                            width: side-tabs.width;
                            height: 35px;
                            vertical: true;
                            collapsed: root.collapsed-tabs;
                            tab-step: 38px;
                            tab: tab;
                            closable: root.tabs.length > 1;
                            selected => { root.select-tab(index); }
                            closed => { root.close-tab(index); }
                            toggle-pin => { root.toggle-tab-pin(index); }
                            toggle-mute => { root.toggle-tab-mute(index); }
                            dragged(steps) => { root.move-tab(index, Math.max(0, Math.min(root.tabs.length - 1, index + steps))); }
                        }
                    }
                    ChromeButton {
                        width: 42px;
                        label: "+";
                        accessible-label: "New tab";
                        clicked => { root.new-tab(); }
                    }
                }
            }

            web-view-area := Rectangle {
                horizontal-stretch: 1;
                background: (ChromeTheme.light ? #f5f8fd : #0c1117);

                if root.web-view-visible: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.web-view-texture;
                    image-fit: fill;
                }

                if root.is-loading: Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * 45%;
                    height: 2px;
                    background: (ChromeTheme.light ? #1469a7 : #62bfff);
                }

                if root.is-new-tab: Rectangle {
                    background: root.new-tab-gradient
                        ? (ChromeTheme.light ? @linear-gradient(155deg, #f9fbff, #dce9fc) : @linear-gradient(155deg, #182b43, #0c1117 80%))
                        : (ChromeTheme.light ? #f5f8fd : #0c1117);

                    appearance := PopupWindow {
                        width: 254px;
                        height: 184px;
                        x: Math.max(0px, web-view-area.width - 270px);
                        y: Math.max(0px, web-view-area.height - 232px);
                        Rectangle {
                            background: (ChromeTheme.light ? #ffffff : #171f29);
                            border-width: 1px;
                            border-color: (ChromeTheme.light ? #b4c4d7 : #344454);
                            border-radius: 12px;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                Text { text: "Theme"; color: ChromeTheme.light ? #142337 : #edf4fa; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    for name[i] in ["System", "Light", "Dark"]: ActionButton {
                                        label: name;
                                        highlighted: ChromeTheme.mode == i;
                                        clicked => { root.appearance-changed(i, root.new-tab-gradient); }
                                    }
                                }
                                Text { text: "New tab background"; color: ChromeTheme.light ? #142337 : #edf4fa; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    ActionButton { label: "Solid"; highlighted: !root.new-tab-gradient; clicked => { root.appearance-changed(ChromeTheme.mode, false); } }
                                    ActionButton { label: "Gradient"; highlighted: root.new-tab-gradient; clicked => { root.appearance-changed(ChromeTheme.mode, true); } }
                                }
                            }
                        }
                    }

                    new-tab-content := Rectangle {
                        width: Math.max(0px, Math.min(parent.width - 32px, 560px));
                        height: root.bookmarks.length > 0 ? 340px : 180px;
                        x: (parent.width - self.width) / 2;
                        y: Math.max(24px, (parent.height - self.height) / 2 - 24px);
                        background: transparent;

                        VerticalLayout {
                            spacing: 11px;

                            HorizontalLayout {
                                alignment: center;
                                height: 56px;

                                Image {
                                    width: 54px;
                                    height: 54px;
                                    source: @image-url("../../../apps/hermes-desktop/resources/hermes-browser.svg");
                                    image-fit: contain;
                                }
                            }

                            Text {
                                text: "Hermes Browser";
                                color: (ChromeTheme.light ? #142337 : #edf4fa);
                                font-size: 28px;
                                font-weight: 650;
                                horizontal-alignment: center;
                            }


                            Rectangle {
                                height: 48px;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: new-tab-search.has-focus ? (ChromeTheme.light ? #1469a7 : #62bfff) : (ChromeTheme.light ? #c7d3e1 : #29333e);
                                background: (ChromeTheme.light ? #ffffff : #171f29);

                                if new-tab-search.text == "": Text {
                                    x: 18px;
                                    width: parent.width - 82px;
                                    height: parent.height;
                                    text: "Search with DuckDuckGo or enter an address";
                                    color: (ChromeTheme.light ? #4b6179 : #717e8e);
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                new-tab-search := TextInput {
                                    x: 18px;
                                    width: parent.width - 82px;
                                    height: parent.height;
                                    color: (ChromeTheme.light ? #142337 : #edf4fa);
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    single-line: true;

                                    accepted => {
                                        root.navigate(self.text);
                                    }
                                }

                                search-button := Rectangle {
                                    x: parent.width - 52px;
                                    y: 6px;
                                    width: 42px;
                                    height: 36px;
                                    border-radius: 8px;
                                    background: search-touch.pressed
                                        ? #45a9ed
                                        : search-touch.has-hover ? #78caff : (ChromeTheme.light ? #1469a7 : #62bfff);

                                    Text {
                                        text: "→";
                                        color: #09131c;
                                        font-size: 20px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    search-touch := TouchArea {
                                        clicked => {
                                            root.navigate(new-tab-search.text);
                                        }
                                    }
                                }
                            }

                            if root.bookmarks.length > 0: Text {
                                text: "Bookmarks";
                                color: (ChromeTheme.light ? #40536a : #a4b2bf);
                                font-size: 13px;
                                font-weight: 600;
                            }
                            if root.bookmarks.length > 0: bookmark-grid := Flickable {
                                height: 158px;
                                viewport-width: self.width;
                                viewport-height: Math.ceil(root.bookmarks.length / tiles.columns) * 78px;
                                tiles := Rectangle {
                                    property <int> columns: Math.max(1, Math.min(4, Math.floor(self.width / 96px)));
                                    width: bookmark-grid.viewport-width;
                                    height: bookmark-grid.viewport-height;
                                    for bookmark[index] in root.bookmarks: Rectangle {
                                        width: parent.width / tiles.columns - 6px;
                                        height: 72px;
                                        x: Math.mod(index, tiles.columns) * (parent.width / tiles.columns);
                                        y: Math.floor(index / tiles.columns) * 78px;
                                        border-radius: 12px;
                                        background: hit.has-hover ? (ChromeTheme.light ? #dce7f2 : #263746) : (ChromeTheme.light ? #ffffff : #171f29);
                                        accessible-role: button;
                                        accessible-label: bookmark.label;
                                        accessible-action-default => { root.navigate(bookmark.address); }
                                        Text {
                                            y: 7px;
                                            width: parent.width;
                                            height: 28px;
                                            text: bookmark.initial;
                                            color: (ChromeTheme.light ? #125f98 : #71c5ff);
                                            font-size: 20px;
                                            font-weight: 650;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            x: 6px;
                                            y: 40px;
                                            width: parent.width - 12px;
                                            text: bookmark.label;
                                            color: (ChromeTheme.light ? #142337 : #edf4fa);
                                            horizontal-alignment: center;
                                            overflow: elide;
                                        }
                                        hit := TouchArea { clicked => { root.navigate(bookmark.address); } }
                                        ContextMenuArea {
                                            Menu {
                                                MenuItem {
                                                    title: "Remove shortcut";
                                                    activated => { root.remove-bookmark(bookmark.address); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.content-message != "": Text {
                                text: root.content-message;
                                color: (ChromeTheme.light ? #4b6179 : #727f8f);
                                font-size: 12px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                    ActionButton {
                        x: Math.max(0px, parent.width - self.width - 16px);
                        y: Math.max(0px, parent.height - self.height - 16px);
                        width: 104px;
                        label: "Customize";
                        clicked => { appearance.show(); }
                    }

                }

                if !root.web-view-visible && !root.is-new-tab: VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    padding-left: 32px;
                    padding-right: 32px;

                    Text {
                        text: root.content-message;
                        color: (ChromeTheme.light ? #42566e : #8c99a9);
                        font-size: 14px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                web-view-focus := FocusScope {
                    enabled: root.web-view-visible;
                    focus-on-click: false;
                    focus-on-tab-navigation: false;

                    focus-gained => {
                        root.web-view-focus-changed(true);
                    }

                    focus-lost => {
                        root.web-view-focus-changed(false);
                    }

                    web-view-input := TouchArea {
                        enabled: root.web-view-visible;

                        property <WebViewPointerButton> active-button: WebViewPointerButton.other;

                        function map-pointer-button(
                            button: PointerEventButton,
                        ) -> WebViewPointerButton {
                            if button == PointerEventButton.left {
                                return WebViewPointerButton.left;
                            }

                            if button == PointerEventButton.middle {
                                return WebViewPointerButton.middle;
                            }

                            if button == PointerEventButton.right {
                                return WebViewPointerButton.right;
                            }

                            return WebViewPointerButton.other;
                        }

                        pointer-event(event) => {
                            if event.kind == PointerEventKind.move {
                                root.web-view-pointer-moved(
                                    self.mouse-x / 1px,
                                    self.mouse-y / 1px,
                                );
                            } else if event.kind == PointerEventKind.down {
                                web-view-focus.focus();
                                self.active-button = self.map-pointer-button(event.button);

                                root.web-view-pointer-button(
                                    self.active-button,
                                    true,
                                    self.mouse-x / 1px,
                                    self.mouse-y / 1px,
                                );
                            } else if event.kind == PointerEventKind.up {
                                root.web-view-pointer-button(
                                    self.map-pointer-button(event.button),
                                    false,
                                    self.mouse-x / 1px,
                                    self.mouse-y / 1px,
                                );

                                self.active-button = WebViewPointerButton.other;
                            } else if event.kind == PointerEventKind.cancel {
                                root.web-view-pointer-button(
                                    self.active-button,
                                    false,
                                    self.mouse-x / 1px,
                                    self.mouse-y / 1px,
                                );

                                self.active-button = WebViewPointerButton.other;
                            }
                        }

                        scroll-event(event) => {
                            root.web-view-scrolled(
                                event.delta-x / 1px,
                                event.delta-y / 1px,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );

                            accept
                        }
                    }
                }
                if root.address-focused && root.suggestions.length > 0 && !root.page-fullscreen: Rectangle {
                    x: Math.min(146px, parent.width / 4);
                    y: 1px;
                    width: parent.width - self.x - 10px;
                    height: 10px + root.suggestions.length * 42px;
                    background: ChromeTheme.light ? #ffffff : #171f29;
                    border-color: ChromeTheme.light ? #b4c4d7 : #344454;
                    border-width: 1px;
                    border-radius: 10px;
                    VerticalLayout {
                        padding: 5px;
                        for suggestion[i] in root.suggestions: Rectangle {
                            height: 42px;
                            border-radius: 6px;
                            background: row.has-hover || root.selected-suggestion == i
                                ? (ChromeTheme.light ? #dce7f2 : #263746) : transparent;
                            accessible-role: button;
                            accessible-label: suggestion.label;
                            accessible-action-default => { root.accept-suggestion(i); }
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;
                                Text {
                                    text: suggestion.label;
                                    color: ChromeTheme.light ? #142337 : #edf4fa;
                                    overflow: elide;
                                }
                                Text {
                                    text: suggestion.address;
                                    color: ChromeTheme.light ? #40536a : #a4b2bf;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                            row := TouchArea { clicked => { root.accept-suggestion(i); } }
                        }
                    }
                }
            }
        }
    }
}
