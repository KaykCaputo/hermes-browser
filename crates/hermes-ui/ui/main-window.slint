export enum WebViewPointerButton {
    left,
    middle,
    right,
    other,
}

component ChromeButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 36px;
    height: 32px;
    border-radius: 8px;
    background: button-area.has-hover && root.enabled ? #e6e9f2 : transparent;
    opacity: root.enabled ? 1 : 0.38;

    Text {
        text: root.label;
        color: #363b4d;
        font-size: 17px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-area := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

component TabIcon inherits Rectangle {
    in property <image> source;

    width: 18px;
    background: transparent;

    Image {
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.source;
        image-fit: contain;
    }
}

export component MainWindow inherits Window {
    in property <string> page-title: "New tab";
    in-out property <string> address: "";
    in property <image> page-icon;
    in property <bool> has-page-icon: false;
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;
    in property <bool> is-loading: false;
    in property <bool> is-new-tab: true;
    in property <bool> web-view-visible: false;
    out property <length> web-view-width: web-view-area.width;
    out property <length> web-view-height: web-view-area.height;
    in property <string> content-message: "Type an address or search with DuckDuckGo.";

    callback navigate(string);
    callback go-back;
    callback go-forward;
    callback reload;
    callback web-view-pointer-moved(float, float);
    callback web-view-pointer-button(WebViewPointerButton, bool, float, float);
    callback web-view-scrolled(float, float, float, float);
    callback web-view-focus-changed(bool);

    title: page-title + " — Hermes Browser";
    icon: @image-url("../../../apps/hermes-desktop/resources/hermes-browser.svg");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 480px;
    min-height: 480px;
    background: #f5f6fa;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 40px;
            background: #e9ebf2;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 0px;

                Rectangle {
                    width: 250px;
                    border-radius: 9px;
                    background: #f5f6fa;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        if root.has-page-icon: TabIcon {
                            source: root.page-icon;
                        }

                        if !root.has-page-icon: TabIcon {
                            source: @image-url("../../../apps/hermes-desktop/resources/hermes-browser.svg");
                        }

                        Text {
                            text: root.page-title;
                            color: #252938;
                            font-size: 13px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }
            }
        }

        Rectangle {
            height: 54px;
            background: #f5f6fa;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 7px;

                ChromeButton {
                    label: "‹";
                    enabled: root.can-go-back;
                    clicked => {
                        root.go-back();
                    }
                }

                ChromeButton {
                    label: "›";
                    enabled: root.can-go-forward;
                    clicked => {
                        root.go-forward();
                    }
                }

                ChromeButton {
                    label: "↻";
                    clicked => {
                        root.reload();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 34px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: address-input.has-focus ? #6957d9 : #d5d8e3;
                    background: #ffffff;

                    address-input := TextInput {
                        x: 13px;
                        width: parent.width - 26px;
                        height: parent.height;
                        text <=> root.address;
                        color: #252938;
                        font-size: 14px;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => {
                            root.navigate(self.text);
                        }
                    }
                }

                ChromeButton {
                    label: "⋮";
                }
            }

            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: #dfe2eb;
            }
        }

        web-view-area := Rectangle {
            vertical-stretch: 1;
            background: root.web-view-visible ? transparent : #ffffff;

            if root.is-loading: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * 45%;
                height: 2px;
                background: #6957d9;
            }

            if root.is-new-tab: Rectangle {
                background: #ffffff;

                new-tab-content := Rectangle {
                    width: parent.width < 680px ? parent.width - 48px : 616px;
                    height: 330px;
                    x: (parent.width - self.width) / 2;
                    y: Math.max(24px, (parent.height - self.height) / 2 - 28px);

                    VerticalLayout {
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: center;
                            height: 112px;

                            Image {
                                width: 112px;
                                height: 112px;
                                source: @image-url("../../../apps/hermes-desktop/resources/hermes-browser.svg");
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: "Hermes Browser";
                            color: #202537;
                            font-size: 30px;
                            font-weight: 650;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Fast, lightweight and private by default";
                            color: #74798b;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }

                        Rectangle {
                            height: 48px;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: new-tab-search.has-focus ? #0a6fd3 : #d5dce8;
                            background: #f8faff;

                            if new-tab-search.text == "": Text {
                                x: 18px;
                                width: parent.width - 82px;
                                height: parent.height;
                                text: "Search with DuckDuckGo or enter an address";
                                color: #949aac;
                                font-size: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            new-tab-search := TextInput {
                                x: 18px;
                                width: parent.width - 82px;
                                height: parent.height;
                                color: #252938;
                                font-size: 14px;
                                vertical-alignment: center;
                                single-line: true;

                                accepted => {
                                    root.navigate(self.text);
                                }
                            }

                            search-button := Rectangle {
                                x: parent.width - 52px;
                                y: 6px;
                                width: 42px;
                                height: 36px;
                                border-radius: 10px;
                                background: search-touch.has-hover ? #095fb4 : #0a6fd3;

                                Text {
                                    text: "→";
                                    color: #ffffff;
                                    font-size: 20px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                search-touch := TouchArea {
                                    clicked => {
                                        root.navigate(new-tab-search.text);
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.content-message;
                            color: #8a90a1;
                            font-size: 12px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if !root.web-view-visible && !root.is-new-tab: VerticalLayout {
                alignment: center;
                spacing: 10px;
                padding-left: 32px;
                padding-right: 32px;

                Text {
                    text: root.content-message;
                    color: #74798b;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            web-view-focus := FocusScope {
                enabled: root.web-view-visible;
                focus-on-click: false;
                focus-on-tab-navigation: false;

                focus-gained => {
                    root.web-view-focus-changed(true);
                }

                focus-lost => {
                    root.web-view-focus-changed(false);
                }

                web-view-input := TouchArea {
                    enabled: root.web-view-visible;

                    property <WebViewPointerButton> active-button: WebViewPointerButton.other;

                    function map-pointer-button(
                        button: PointerEventButton,
                    ) -> WebViewPointerButton {
                        if button == PointerEventButton.left {
                            return WebViewPointerButton.left;
                        }

                        if button == PointerEventButton.middle {
                            return WebViewPointerButton.middle;
                        }

                        if button == PointerEventButton.right {
                            return WebViewPointerButton.right;
                        }

                        return WebViewPointerButton.other;
                    }

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move {
                            root.web-view-pointer-moved(
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );
                        } else if event.kind == PointerEventKind.down {
                            web-view-focus.focus();
                            self.active-button = self.map-pointer-button(event.button);

                            root.web-view-pointer-button(
                                self.active-button,
                                true,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );
                        } else if event.kind == PointerEventKind.up {
                            root.web-view-pointer-button(
                                self.map-pointer-button(event.button),
                                false,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );

                            self.active-button = WebViewPointerButton.other;
                        } else if event.kind == PointerEventKind.cancel {
                            root.web-view-pointer-button(
                                self.active-button,
                                false,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );

                            self.active-button = WebViewPointerButton.other;
                        }
                    }

                    scroll-event(event) => {
                        root.web-view-scrolled(
                            event.delta-x / 1px,
                            event.delta-y / 1px,
                            self.mouse-x / 1px,
                            self.mouse-y / 1px,
                        );

                        accept
                    }
                }
            }
        }
    }
}
